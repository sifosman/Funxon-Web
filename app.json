{
  "expo": {
    "name": "Funxon",
    "slug": "vibeventz-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#123f5c"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyBjd1KYtTaAzxzdw5ayGwwMu5Sex-gKQLI"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Funxon needs camera access so you can capture event and profile photos.",
        "NSPhotoLibraryUsageDescription": "Funxon needs access to your photo library so you can upload event and profile images.",
        "NSLocationWhenInUseUsageDescription": "Funxon uses your location to show you relevant events and vendors near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f7f5f0"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBjd1KYtTaAzxzdw5ayGwwMu5Sex-gKQLI"
        }
      },
      "package": "com.anonymous.vibeventzapp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "androidStatusBar": {
        "backgroundColor": "#00000000",
        "translucent": true,
        "barStyle": "dark-content"
      },
      "androidNavigationBar": {
        "backgroundColor": "#00000000",
        "barStyle": "dark-content",
        "visible": "visible"
      },
      "navigationBar": {
        "visible": "visible"
      }
    },
    "scheme": ["vibeventz", "funxon"],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "./plugins/withMaps.js",
        {
          "googleMapsApiKey": "AIzaSyBjd1KYtTaAzxzdw5ayGwwMu5Sex-gKQLI"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.686531626266-vp4hdm0nj6mkkvqsudbkm3pt00mcn15p"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "536d0059-dd1a-452c-b92a-67e2b2da6d31"
      }
    },
    "owner": "sifosman"
  }
}
