{
  "redirects": [
    { "source": "/assets/node_modules/@expo/vector-icons/:path*", "destination": "/assets/fonts/MaterialIcons.ttf", "permanent": false },
    { "source": "/assets/node_modules/@expo-google-fonts/montserrat/:path*", "destination": "/assets/fonts/Montserrat-Regular.ttf", "permanent": false },
    { "source": "/assets/node_modules/@expo-google-fonts/playfair-display/:path*", "destination": "/assets/fonts/PlayfairDisplay-Regular.ttf", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_expo/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
