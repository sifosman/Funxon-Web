# Copy this file to .env and fill in your Supabase project details
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder

# Google Maps / Places (used for address autocomplete and map selectors)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Support contact details (used by HelpCenterModal)
VITE_SUPPORT_EMAIL=support@funxon.co.za
VITE_SUPPORT_WHATSAPP=+27837093579

# PayFast Configuration
VITE_PAYFAST_MERCHANT_ID=your_payfast_merchant_id
VITE_PAYFAST_MERCHANT_KEY=your_payfast_merchant_key
VITE_PAYFAST_SANDBOX=true

# Brevo Email Configuration (server-side only, used by Edge Functions)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
FROM_EMAIL=noreply@funxon.com
FROM_NAME=Funxon Team

# HubSpot CMS Blog API (server-side only, used by the Vercel proxy)
# Use a Service Key (recommended) or Private App token:
#   1. In HubSpot, go to Settings > Account Defaults > Service Keys
#   2. Click "Generate service key" and copy it
#   3. If using Private Apps instead, ensure the 'content' scope is enabled
HUBSPOT_ACCESS_TOKEN=your_hubspot_service_key_here
