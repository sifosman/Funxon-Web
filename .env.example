# Copy this file to .env and fill in your Supabase project details
EXPO_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=placeholder

# Google Maps / Places (used for address autocomplete in vendor application)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Brevo Email Configuration (for sending vendor welcome emails)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
FROM_EMAIL=noreply@funxon.co.za
FROM_NAME=Funxon Team

# HubSpot CMS Blog API
# Use a Service Key (recommended) or Private App token:
#   1. In HubSpot, go to Settings > Account Defaults > Service Keys
#   2. Click "Generate service key" and copy it
#   3. If using Private Apps instead, ensure the 'content' scope is enabled
EXPO_PUBLIC_HUBSPOT_ACCESS_TOKEN=your_hubspot_service_key_here

# PayFast Configuration
# Set to 'true' for sandbox mode, 'false' for production
EXPO_PUBLIC_PAYFAST_SANDBOX=true
EXPO_PUBLIC_PAYFAST_MERCHANT_ID=your_payfast_merchant_id
EXPO_PUBLIC_PAYFAST_MERCHANT_KEY=your_payfast_merchant_key
EXPO_PUBLIC_PAYFAST_PASSPHRASE=your_payfast_passphrase